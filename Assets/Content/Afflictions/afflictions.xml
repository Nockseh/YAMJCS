        <Effect minStrength="15" maxStrength="35" strengthChange="0"
                minVitalityDecrease="0.00" maxVitalityDecrease="0.10" multiplyByMaxVitality="true"
                minSpeedMultiplier="1.00" maxSpeedMultiplier="0.95"
                resistanceFor="stun,incrementalstun,progressivestun"
                minResistance="0.00" maxResistance="-0.10"
                minAfflictionOverlayAlphaMultiplier="0.00" maxAfflictionOverlayAlphaMultiplier="0.15">
            <StatValue statType="MeleeAttackMultiplier" minValue="0.00" maxValue="-0.15"/>
        </Effect>
        <Effect minStrength="35" maxStrength="55" strengthChange="0"
                minVitalityDecrease="0.10" maxVitalityDecrease="0.35" multiplyByMaxVitality="true"
                minSpeedMultiplier="0.95" maxSpeedMultiplier="0.85"
                resistanceFor="stun,incrementalstun,progressivestun"
                minResistance="-0.10" maxResistance="-0.50"
                minAfflictionOverlayAlphaMultiplier="0.15" maxAfflictionOverlayAlphaMultiplier="0.35">
            <StatValue statType="MeleeAttackMultiplier" minValue="-0.15" maxValue="-0.30"/>
        </Effect>
        <Effect minStrength="55" maxStrength="75" strengthChange="0"
                minVitalityDecrease="0.35" maxVitalityDecrease="0.70" multiplyByMaxVitality="true"
                minSpeedMultiplier="0.85" maxSpeedMultiplier="0.70"
                resistanceFor="stun,incrementalstun,progressivestun"
                minResistance="-0.50" maxResistance="-1.00"
                minAfflictionOverlayAlphaMultiplier="0.35" maxAfflictionOverlayAlphaMultiplier="0.75">
            <StatValue statType="MeleeAttackMultiplier" minValue="-0.30" maxValue="-0.50"/>
        </Effect>
        <Effect minStrength="75" maxStrength="100" strengthChange="0"
                minVitalityDecrease="0.50" maxVitalityDecrease="2.01" multiplyByMaxVitality="true"
                minSpeedMultiplier="0.95" maxSpeedMultiplier="0.40"
                resistanceFor="stun,incrementalstun,progressivestun"
                minResistance="-1.00" maxResistance="-2.00"
                minAfflictionOverlayAlphaMultiplier="0.90" maxAfflictionOverlayAlphaMultiplier="1.00"
                minGrainStrength="0.0" maxGrainStrength="20.0" grainColor="127,40,5,255">
            <StatValue statType="MeleeAttackMultiplier" minValue="-0.10" maxValue="-0.50"/>
        </Effect>
        <Description target="Self" textIdentifier="afflictiondescription.yamjHunger.self.veryLow"       minStrength="0"     maxStrength="15"/>
        <Description target="Self" textIdentifier="afflictiondescription.yamjHunger.self.low"           minStrength="15"    maxStrength="35"/>
        <Description target="Self" textIdentifier="afflictiondescription.yamjHunger.self.medium"        minStrength="35"    maxStrength="55"/>
        <Description target="Self" textIdentifier="afflictiondescription.yamjHunger.self.high"          minStrength="55"    maxStrength="75"/>
