        <Description target="OtherCharacter" textIdentifier="afflictiondescription.yamjHunger.veryLow"  minStrength="0"     maxStrength="15"/>
        <Description target="OtherCharacter" textIdentifier="afflictiondescription.yamjHunger.low"      minStrength="15"    maxStrength="35"/>
        <Description target="OtherCharacter" textIdentifier="afflictiondescription.yamjHunger.medium"   minStrength="35"    maxStrength="55"/>
        <Description target="OtherCharacter" textIdentifier="afflictiondescription.yamjHunger.high"     minStrength="55"    maxStrength="75"/>
        <Description target="OtherCharacter" textIdentifier="afflictiondescription.yamjHunger.veryHigh" minStrength="75"    maxStrength="100"/>
