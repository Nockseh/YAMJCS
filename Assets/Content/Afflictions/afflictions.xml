    <Affliction Identifier="yamjSatiated"
                Type="buff" IsBuff="true" limbspecific="false"
                ShowBarInHealthMenu="true"
                ActivationThreshold="0"
                ShowIconThreshold="1"
                MaxStrength="100"
                IconColors="184,255,196;0,204,102;159,129,51;128,53,0"
                Targets="Mudraptor_player,Mudraptor_playerhusk">
        <Icon Texture="Content/UI/MainIconsAtlas.png" SourceRect="128,384,128,128" Origin="0,0"/>
        <!-- Low -->
        <Effect MinStrength="0" MaxStrength="50" StrengthChange="0"
                MinVitalityDecrease="0.00" MaxVitalityDecrease="-0.25" MultiplyByMaxVitality="true"
                MinSpeedMultiplier="1.00" MaxSpeedMultiplier="1.00">
        <StatValue StatType="MeleeAttackMultiplier" MinValue="0.00" MaxValue="0.05"/>
        </Effect>
        <!-- High -->
        <Effect MinStrength="50" MaxStrength="100" StrengthChange="0"
                MinVitalityDecrease="-0.25" MaxVitalityDecrease="-0.50" MultiplyByMaxVitality="true"
                MinSpeedMultiplier="1.00" MaxSpeedMultiplier="0.60"
                ResistanceFor="stun,incrementalstun,progressivestun"
                MinResistance="0.00" MaxResistance="-0.25">
            <StatValue StatType="MeleeAttackMultiplier" MinValue="0.05" MaxValue="-0.20"/>
            <StatusEffect type="OnActive" target="Character">
                <!-- I promise these are actually rates per-second (applied every frame) -->
                <ReduceAffliction type="damage" strength="0.25" />
                <ReduceAffliction type="burn" strength="0.10" />
            </StatusEffect>
        </Effect>
        
        <Description Target="Self" TextIdentifier="afflictiondescription.yamjSatiated.self.low"       MinStrength="0"     MaxStrength="50"/>
        <Description Target="OtherCharacter" TextIdentifier="afflictiondescription.yamjSatiated.low"  MinStrength="0"     MaxStrength="50"/>
        <Description Target="Self" TextIdentifier="afflictiondescription.yamjSatiated.self.high"       MinStrength="50"     MaxStrength="100"/>
        <Description Target="OtherCharacter" TextIdentifier="afflictiondescription.yamjSatiated.high"  MinStrength="50"     MaxStrength="100"/>
    </Affliction>
    
