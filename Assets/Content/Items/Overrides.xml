      <StatusEffect tags="poison" type="OnUse" target="Character" duration="20">
        <Conditional speciesName="Mudraptor_player" />
        <Affliction identifier="organdamage" amount="10" />
      </StatusEffect>
    </Projectile>
  </raptorbaneextract>
