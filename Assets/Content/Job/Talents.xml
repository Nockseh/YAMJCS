  <!--Raptor Nap-->
  <Talent identifier="yamjSleepTime">
    <Icon texture="%ModDir%/Job/YAMJTalentsIcons.png" sheetindex="7,0" sheetElementSize="128,128" />
    <Description tag="talentdescription.yamjSleepTime">
      <Replace tag="[seconds]" value="yamjConfig.SleepWindupTime.float" color="gui.green" />
    </Description>
    <AbilityGroupInterval effectDelay="5" interval="3.25" configoverride="effectDelay=SleepWindupTime">
      <Conditions>
        <AbilityConditionInWater invert="true" />
        <AbilityConditionRagdolled />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character" disableDeltaTime="true" multiplyAfflictionsByMaxVitality="true">
              <Sound file="%ModDir%/Sounds/Snores/RaptorSnooze1.ogg" volume="0.25" range="200" selectionMode="Random" />
              <Sound file="%ModDir%/Sounds/Snores/RaptorSnooze2.ogg" volume="0.25" range="200" />
              <Sound file="%ModDir%/Sounds/Snores/RaptorSnooze3.ogg" volume="0.25" range="200" />
              <Sound file="%ModDir%/Sounds/Snores/RaptorSnooze4.ogg" volume="0.25" range="200" />
              <Sound file="%ModDir%/Sounds/Snores/RaptorSnooze5.ogg" volume="0.25" range="200" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupInterval>
    <AbilityGroupInterval effectDelay="5" configoverride="effectDelay=SleepWindupTime">
      <Conditions>
        <AbilityConditionInWater invert="true" />
        <AbilityConditionRagdolled />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="Character">
              <Affliction identifier="yamjSleepTimeVfx" amount="5.0" />
              <Affliction identifier="yamjSleepTimeIcon" amount="2.0" />
              <ReduceAffliction type="damage" strength="0.16" configoverride="strength=SleepHealSelfDamage" />
              <ReduceAffliction type="burn" strength="0.10" configoverride="strength=SleepHealSelfBurn" />
              <ReduceAffliction identifier="bleeding" strength="0.06" configoverride="strength=SleepHealSelfBleeding" />
              <ReduceAffliction identifier="bloodloss" strength="0.10" configoverride="strength=SleepHealSelfBloodLoss" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupInterval>
  </Talent>

  <Talent identifier="yamjSleepTime2">
    <Icon texture="%ModDir%/Job/YAMJTalentsIcons.png" sheetindex="0,1" sheetElementSize="128,128" />
    <Description tag="talentdescription.yamjSleepTime2">
