  <Talent identifier="yamjBondSecurity">
    <Icon texture="%ModDir%/Job/YAMJTalentsIcons.png" sheetindex="1,2" sheetElementSize="128,128" />
    <Description tag="talentdescription.yamjBondSecurity">
      <Replace tag="[maxCharge]" value="yamjConfig.ChargedBiteCooldown.int" color="gui.orange" />
      <Replace tag="[damageBonus]" value="yamjConfig.ChargedBiteDamageBonus.percent" color="gui.green" />
