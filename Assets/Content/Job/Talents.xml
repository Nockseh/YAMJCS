      <Replace tag="[refund]" value="yamjConfig.ChargedBiteCooldownReward.float" color="gui.orange" />
    </Description>
    <!-- nearby crewmates: suit vision cones removed -->
    <AbilityGroupInterval interval="0.5">
      <Abilities>
        <CharacterAbilityApplyStatusEffects nearbyCharactersAppliesToSelf="false" nearbyCharactersAppliesToEnemies="false">
          <StatusEffects>
            <StatusEffect type="OnAbility" target="NearbyCharacters" range="2000" setValue="true" disableDeltaTime="true" multiplyAfflictionsByMaxVitality="true" configoverride="range=ClearVisionRange">
              <Conditional isPlayer="true" />
              <Affliction identifier="yamjClearVision" strength="2" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupInterval>
    <!-- passive bite charge: +1 per second, full at yamjBiteCharge's maxstrength -->
    <AbilityGroupInterval interval="1">
      <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="This" multiplyAfflictionsByMaxVitality="true" disableDeltaTime="true">
              <Affliction identifier="yamjBiteCharge" amount="1.0" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupInterval>
    <!-- fully charged attack: bonus damage and stun -->
    <AbilityGroupEffect abilityEffectType="OnAttack">
      <Conditions>
        <AbilityConditionHasAffliction afflictionIdentifier="yamjBiteCharge" minimumPercentage="1.00" />
        <AbilityConditionAttackData weaponType="NoWeapon" />
        <AbilityConditionCharacter targetTypes="Alive" />
      </Conditions>
      <Abilities>
        <CharacterAbilityModifyAttackData addedDamageMultiplier="0.5" configoverride="addedDamageMultiplier=ChargedBiteDamageBonus" />
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="UseTarget">
              <Affliction identifier="stun" amount="6" configoverride="amount=ChargedBiteStun" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupEffect>
    <!-- spend charge on max (conditions should match the group above) -->
    <AbilityGroupEffect abilityEffectType="OnAttack">
      <Conditions>
        <AbilityConditionHasAffliction afflictionIdentifier="yamjBiteCharge" minimumPercentage="1.00" />
        <AbilityConditionAttackData weaponType="NoWeapon" />
        <AbilityConditionCharacter targetTypes="Alive" />
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="This">
              <ReduceAffliction identifier="yamjBiteCharge" strength="1000" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupEffect>
    <!-- partial refund if target marked (last) -->
    <AbilityGroupEffect abilityEffectType="OnAttack">
      <Conditions>
        <AbilityConditionAttackData weaponType="NoWeapon" />
        <AbilityConditionCharacter targetTypes="Alive">
          <Conditional yamjMarked="gt 0" />
        </AbilityConditionCharacter>
      </Conditions>
      <Abilities>
        <CharacterAbilityApplyStatusEffects>
          <StatusEffects>
            <StatusEffect type="OnAbility" target="This" multiplyAfflictionsByMaxVitality="true" disableDeltaTime="true">
              <Affliction identifier="yamjBiteCharge" amount="6" configoverride="amount=ChargedBiteCooldownReward" />
            </StatusEffect>
          </StatusEffects>
        </CharacterAbilityApplyStatusEffects>
      </Abilities>
    </AbilityGroupEffect>
  </Talent>
  
